# Server
PORT=3001

# Auth
JWT_SECRET=your-secret-here

# Database
DATABASE_URL="file:./dev.db"

# ── AI Provider ────────────────────────────────────────────────────────────
# Which AI backend to use: ollama | anthropic | openai
AI_PROVIDER=ollama

# Model name — defaults per provider if not set:
#   ollama:    llama3
#   anthropic: claude-sonnet-4-6
#   openai:    gpt-4o
AI_MODEL=deepseek-v3.1:671b-cloud

# Ollama (local, free) — install from https://ollama.com
# Run: ollama pull llama3
OLLAMA_BASE_URL=http://localhost:11434

# Anthropic — requires API billing at console.anthropic.com
# ANTHROPIC_API_KEY=sk-ant-...

# OpenAI — requires API billing at platform.openai.com
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://api.openai.com/v1  # change for Azure or other proxies
